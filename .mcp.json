{
  "mcpServers": {
    "obsidianvault": {"command": "npx", "args": ["-y", "@modelcontextprotocol/server-filesystem", "${CQC_VAULT}"]},
    "selenium-lem": {
      "command": "poetry",
      "args": [
        "run",
        "python",
        "tools/selenium_mcp_server.py"
      ],
      "env": {
        "SE_REMOTE_URL": "http://127.0.0.1:4444"
      }
    },
    "playwright": {
      "command": "/home/linuxbrew/.linuxbrew/opt/node@24/bin/npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--headless",
        "--isolated"
      ]
    }
  }
}
