[Unit]
Description=Take over PostHog self-driving PRs so lem-agentd finishes them (issue + branch copy + PR, close PostHog's)
Documentation=https://github.com/christopherqueenconsulting/linkedin_engagement_manager/blob/main/docs/posthog-pr-takeover.md

[Service]
Type=oneshot
User=lem
Group=lem
WorkingDirectory=/home/lem/linkedin_engagement_manager
Environment=BASE=/home/lem/agent-pipeline
# The same config.env every pipeline unit reads — POSTHOG_TAKEOVER_ENABLED lives there.
EnvironmentFile=-/home/lem/agent-pipeline/config.env

# Gated HERE, not in the script, for the same reason as lem-triage-hourly: the script must stay
# runnable as a dry run (no --apply) while the timer is off, which is how it is verified first:
#   python3 scripts/posthog_pr_takeover.py
ExecStart=/bin/bash -c '[ "${POSTHOG_TAKEOVER_ENABLED:-0}" = "1" ] || { echo "POSTHOG_TAKEOVER_ENABLED not set — PostHog PR takeover is inert, no-op."; exit 0; }; unset GH_TOKEN; exec python3 scripts/posthog_pr_takeover.py --apply'

TimeoutStartSec=300
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
