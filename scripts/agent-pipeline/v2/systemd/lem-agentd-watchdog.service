[Unit]
Description=LEM agent-pipeline v2 — alert when the daemon is dead
Documentation=https://github.com/christopherqueenconsulting/linkedin_engagement_manager/blob/main/scripts/agent-pipeline/v2/README.md

[Service]
Type=oneshot
# Root, because this restarts a SYSTEM unit: a non-root `systemctl restart` goes through polkit,
# which has no agent inside a oneshot service, so it would fail silently and the first rung of the
# self-heal ladder would never work. Matches the repo's existing lem-watchdog.service.
User=root
Environment=BASE=/home/lem/agent-pipeline
# Deliberately OUTSIDE the daemon: an alert that lives inside the process it watches cannot fire
# when that process is the thing that died. Checks liveness AND heartbeat freshness, because a
# daemon can be "active" while wedged — systemd only knows the pid still exists.
ExecStart=/home/lem/agent-pipeline/v2/watchdog.sh
