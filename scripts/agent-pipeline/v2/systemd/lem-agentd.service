[Unit]
Description=LEM agent-pipeline v2 scheduler daemon
Documentation=https://github.com/christopherqueenconsulting/linkedin_engagement_manager/blob/main/scripts/agent-pipeline/v2/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lem
Group=lem
WorkingDirectory=/home/lem/agent-pipeline/v2
Environment=BASE=/home/lem/agent-pipeline
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/home/lem/agent-pipeline/secrets.env
ExecStart=/usr/bin/python3 -m lemd.daemon

# The daemon is restartable at any instant by design: startup_recover() closes runs whose process
# is gone and returns stranded claims to the queue, then one reconcile pass re-derives every item
# from GitHub. So an aggressive restart policy is safe and is the first rung of the self-heal ladder.
Restart=on-failure
RestartSec=10

# Drain, do not kill. KillMode=mixed SIGKILLs every remaining process in the cgroup once the stop
# timeout expires — and agent runs reach 45 minutes, so a 300s timeout would kill up to four agents
# mid-`git push`, leaving exactly the half-pushed branch this was meant to prevent (budget already
# charged, next observation re-dispatches). KillMode=process signals only the daemon; agent children
# are launched into their own transient scopes by the dispatcher so they outlive a daemon restart.
KillMode=process
TimeoutStopSec=90

# Shares the ceiling v1's agents already run under, so v2 cannot outbid the prod stack (Selenium
# grid, celery, MySQL) that lives on this same box.
# ONE envelope: the slice. A MemoryMax here would be a second, smaller ceiling that the daemon and
# every agent child share, which is how you get an OOM kill that looks like a mysterious agent crash.
Slice=lem-agent.slice

StandardOutput=append:/home/lem/agent-pipeline/logs/lemd.log
StandardError=append:/home/lem/agent-pipeline/logs/lemd.log

[Install]
WantedBy=multi-user.target
