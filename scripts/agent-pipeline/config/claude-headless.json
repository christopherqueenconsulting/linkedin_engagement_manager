{
  "$comment": [
    "Permission profile for headless pipeline agents — the DEFAULT for every MODE.",
    "run_lane.sh launches each agent with `--permission-mode dontAsk --settings <this file>",
    "--output-format json` and logs every denied tool call to $LOGDIR/denials.jsonl.",
    "LEM_PERMISSION_PROFILE=off is the emergency opt-out (docs/agent-pipeline-v2.md).",
    "",
    "Every allow below is a command some runbook/<mode>.md step needs. Two are narrower than they",
    "look on purpose: `git rebase` is allowed only in the four forms MODE=rebase uses (git accepts",
    "abbreviated long options, so a deny list cannot fence off --exec), and GitHub GraphQL is reached",
    "only through lib/review_threads.sh at its installed path — `gh api` stays denied.",
    "`git push --force-with-lease` is allowed by `git push *`; the --force deny patterns need a",
    "space or end after `--force`, so they never match it, and still match a plain --force.",
    "",
    "dontAsk = anything not allowed below is DENIED, never prompted (there is no human to ask).",
    "Settings MERGE across sources: user and project allow rules still apply, and a deny from ANY",
    "source wins.",
    "",
    "Keep `hooks` OUT of `permissions`: a hooks key nested inside the permission block voids the block.",
    "This profile defines no hooks; the user and project settings keep theirs."
  ],
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "TodoWrite",
      "Skill",
      "Agent",
      "Edit(//home/lem/agent-pipeline/work/**)",
      "Write(//home/lem/agent-pipeline/work/**)",

      "Bash(poetry run pytest *)",
      "Bash(poetry run ruff check *)",
      "Bash(ruff check *)",
      "Bash(scripts/ruff_count.sh)",
      "Bash(python3 scripts/check_claude_md_size.py)",
      "Bash(python3 scripts/check_claude_md_size.py *)",
      "Bash(poetry install --with test)",

      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch --show-current)",
      "Bash(git rev-parse *)",
      "Bash(git ls-files *)",
      "Bash(git merge-base *)",
      "Bash(git fetch origin *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git rebase origin/main)",
      "Bash(git rebase --continue)",
      "Bash(git rebase --abort)",
      "Bash(git rebase --skip)",
      "Bash(git switch -c fix/* origin/main)",

      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr ready *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue create *)",
      "Bash(gh issue edit *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(/home/lem/agent-pipeline/lib/review_threads.sh *)",

      "mcp__perplexity__research",
      "mcp__perplexity__fact_check",
      "mcp__playwright"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(docker *)",
      "Bash(docker-compose *)",
      "Bash(systemctl *)",
      "Bash(*deploy.sh*)",
      "Bash(gh workflow run *)",
      "Bash(gh pr merge *)",
      "Bash(gh api *)",
      "Bash(gh secret *)",
      "Bash(gh auth *)",
      "Bash(git -C /opt/lem *)",
      "Bash(git --git-dir=/opt/lem*)",
      "Bash(git --work-tree=/opt/lem*)",
      "Bash(git remote *)",
      "Bash(git config *)",
      "Bash(git push --force *)",
      "Bash(git push * --force)",
      "Bash(git push * --force *)",
      "Bash(git push -f *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push * +*)",
      "Bash(git push * main)",
      "Bash(git push * main:*)",
      "Bash(git push * HEAD:main)",
      "Bash(git push *:main)",
      "Bash(git push *:refs/heads/main)",
      "Bash(git rebase --ex*)",
      "Bash(git rebase * --ex*)",
      "Bash(git rebase -x*)",
      "Bash(git rebase * -x*)",
      "Bash(git rebase -i*)",
      "Bash(git rebase * -i*)",
      "Bash(git rebase --interactive*)",
      "Bash(git rebase * --interactive*)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(env)",
      "Bash(env *)",
      "Bash(printenv *)",
      "WebFetch",

      "Read(//opt/lem/.env)",
      "Read(//opt/lem/.env.*)",
      "Read(**/.env)",
      "Read(//home/lem/agent-pipeline/secrets.env)",
      "Read(//home/lem/agent-pipeline/secrets.env.*)",
      "Read(//home/lem/agent-pipeline/secrets/**)",
      "Read(//home/lem/agent-pipeline/config.env)",
      "Read(//home/lem/agent-pipeline/state/gh-app-token)",
      "Read(//etc/lem/**)",
