{
  "$comment": [
    "OPT-IN permission profile for headless pipeline agents.",
    "Inert unless LEM_PERMISSION_PROFILE points at this file; run_lane.sh then launches the agent with",
    "`--permission-mode dontAsk --settings <this file> --output-format json` in place of the default",
    "permission flag, and logs every denied tool call to $LOGDIR/denials.jsonl.",
    "",
    "dontAsk = anything not allowed below is DENIED, never prompted (there is no human to ask).",
    "Settings MERGE across sources: user and project allow rules still apply, and a deny from ANY",
    "source wins.",
    "",
    "Keep `hooks` OUT of `permissions`: a hooks key nested inside the permission block voids the block.",
    "This profile defines no hooks; the user and project settings keep theirs."
  ],
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "TodoWrite",
      "Skill",
      "Agent",
      "Edit(//home/lem/agent-pipeline/work/**)",
      "Write(//home/lem/agent-pipeline/work/**)",

      "Bash(poetry run pytest *)",
      "Bash(poetry run ruff check *)",
      "Bash(ruff check *)",
      "Bash(scripts/ruff_count.sh)",
      "Bash(python3 scripts/check_claude_md_size.py)",
      "Bash(python3 scripts/check_claude_md_size.py *)",

      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch --show-current)",
      "Bash(git rev-parse *)",
      "Bash(git ls-files *)",
      "Bash(git merge-base *)",
      "Bash(git fetch origin *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push)",
      "Bash(git push *)",

      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr ready *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue create --template agent-task.yml *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",

      "mcp__perplexity__research",
      "mcp__perplexity__fact_check",
      "mcp__playwright"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(docker *)",
      "Bash(docker-compose *)",
      "Bash(systemctl *)",
      "Bash(*deploy.sh*)",
      "Bash(gh workflow run *)",
      "Bash(gh pr merge *)",
      "Bash(gh api *)",
      "Bash(gh secret *)",
      "Bash(gh auth *)",
      "Bash(git -C /opt/lem *)",
      "Bash(git --git-dir=/opt/lem*)",
      "Bash(git --work-tree=/opt/lem*)",
      "Bash(git remote *)",
      "Bash(git config *)",
      "Bash(git push --force *)",
      "Bash(git push * --force)",
      "Bash(git push * --force *)",
      "Bash(git push -f *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push * +*)",
      "Bash(git push * main)",
      "Bash(git push * main:*)",
      "Bash(git push * HEAD:main)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(env)",
      "Bash(printenv *)",
      "WebFetch",

      "Read(//opt/lem/.env)",
      "Read(//opt/lem/.env.*)",
      "Read(**/.env)",
      "Read(//home/lem/agent-pipeline/secrets.env)",
      "Read(//home/lem/agent-pipeline/secrets.env.*)",
      "Read(//home/lem/agent-pipeline/secrets/**)",
      "Read(//home/lem/agent-pipeline/config.env)",
      "Read(//home/lem/agent-pipeline/state/gh-app-token)",
      "Read(//etc/lem/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.config/gh/**)",
      "Read(~/.ssh/**)",
      "Read(//home/lem/linkedin_engagement_manager/.git/config)",

      "Edit(//opt/lem/**)",
      "Edit(//home/lem/agent-pipeline/work/**/.claude/**)",
      "Edit(//home/lem/agent-pipeline/work/**/.git/**)",
      "Edit(//home/lem/agent-pipeline/work/**/.github/workflows/**)",

      "mcp__playwright__browser_file_upload",
      "mcp__selenium-lem"
    ]
  }
}
