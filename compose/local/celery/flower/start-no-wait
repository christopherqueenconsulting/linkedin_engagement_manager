#!/bin/bash

set -o errexit
set -o nounset

# Flower turns basic auth ON whenever FLOWER_BASIC_AUTH is DEFINED — an empty value parses as a
# credential list holding one empty entry, so it locks everyone out rather than meaning "no auth".
# Compose always defines the key (`FOO=${BAR:+...}` yields "" when BAR is unset), so unset it here
# when empty to make the intended "no credentials configured = no auth" actually true. A half-blank
# "user:" / ":pass" is dropped too — that would otherwise enforce a credential nobody intended —
# but noisily, so a typo'd password doesn't quietly look like it's protecting anything.
case "${FLOWER_BASIC_AUTH:-}" in
  "")      unset FLOWER_BASIC_AUTH ;;
  *: | :*) >&2 echo "WARNING: FLOWER_BASIC_AUTH is missing a user or password — ignoring it (no basic auth)."
           unset FLOWER_BASIC_AUTH ;;
esac

# Flower's own persistence logging (`shelve.open` in flower/events.py) only logs at DEBUG, and
# --logging=INFO below deliberately stays off full DEBUG (that also verbosifies celery/tornado
# internals — see #1801). So log the resolved --db path ourselves, once, before Flower can silently
# fall back to its own relative default ('flower' under the container CWD, never the mounted
# /data volume — the exact defect #1795 fixed). This does not depend on Flower's logger config at
# all, so it stays true even if that config changes later.
mkdir -p /app/logs
printf '%s - flower.persistence - INFO - resolved --db path: %s (FLOWER_PERSISTENT=%s)\n' \
  "$(date -u +'%Y-%m-%d %H:%M:%S,%3N')" \
  "${FLOWER_DB:-flower (relative to CWD — FLOWER_DB is unset)}" \
  "${FLOWER_PERSISTENT:-False}" \
  >> /app/logs/flower.log

celery --app cqc_lem.app.my_celery \
  flower \
  --port="${CELERY_FLOWER_PORT}" \
  --address=0.0.0.0 \
  --broker="${CELERY_BROKER_URL}" \
  --broker-api="${CELERY_BROKER_URL}" \
  --logging="INFO" \
  --logfile="/app/logs/flower.log" \
  --state_save_interval="${CELERY_FLOWER_STATE_SAVE_INTERVAL}"
  #--basic_auth=admin:${CELERY_FLOWER_PASSWORD}
