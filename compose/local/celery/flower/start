#!/bin/bash

set -o errexit
set -o nounset

worker_ready() {
    celery --app cqc_lem.app.my_celery inspect ping
}

until worker_ready; do
  >&2 echo 'Celery workers not available'
  sleep 1
done
>&2 echo 'Celery workers is available'

# See start-no-wait: an empty FLOWER_BASIC_AUTH still ENABLES auth (with a credential nobody
# can supply), so unset it rather than let compose's always-defined empty value lock us out.
if [ -z "${FLOWER_BASIC_AUTH:-}" ]; then
  unset FLOWER_BASIC_AUTH
fi

celery --app cqc_lem.app.my_celery \
  --broker="${CELERY_BROKER_URL}" \
  flower \
  --broker-api="${CELERY_BROKER_URL}" \
  --logging="DEBUG" \
  --logfile="/app/logs/flower.log" \
  --debug=True \
  --state_save_interval="${CELERY_FLOWER_STATE_SAVE_INTERVAL}" \
  --persistent=True \
  --db=/data/flower.db
  #--basic_auth=admin:${CELERY_FLOWER_PASSWORD} \
  #-Q (your queue name)

