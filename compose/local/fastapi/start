#!/bin/bash

set -o errexit
set -o pipefail
set -o nounset

# Get the api port
API_PORT=${API_PORT:-8000}

# Start FASTAPI / Uvicorn. Canonical package name only — see start-cloud and issue #1354: the
# `src.cqc_lem...` spelling loads a SECOND copy of api/main.py and silently kills cookie auth on
# every router-served route.
uvicorn cqc_lem.api.main:app --reload --host 0.0.0.0 --port $API_PORT