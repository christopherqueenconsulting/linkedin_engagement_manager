#!/bin/bash

set -o errexit
set -o pipefail
set -o nounset

# Get the api port
API_PORT=${API_PORT:-8000}

# TODO: Add higher worker value if increase API cpu and memory limit
# workers = (2 * CPU_CORES) + 1
API_WORKERS=${API_WORKERS:-1}

# Start FASTAPI / Uvicorn.
#
# The module path MUST be the canonical package name `cqc_lem.api.main`, never
# `src.cqc_lem.api.main`. Both `/app` and `/app/src` are importable, so the second spelling loads
# src/cqc_lem/api/main.py a SECOND time as a distinct module object — and the two copies do not
# share module state. That broke cookie authentication outright (issue #1354): uvicorn served the
# `src.` copy, whose `session_cookie_middleware` published the request cookie on ITS
# `_request_session_cookie` ContextVar, while every `api/routers/*.py` handler read the `cqc_lem.`
# copy's ContextVar, which was always None. Sign-in succeeded and every subsequent call 401'd.
uvicorn cqc_lem.api.main:app --host 0.0.0.0 --port $API_PORT --workers $API_WORKERS --limit-max-requests 10000 --timeout-keep-alive 30 --no-access-log